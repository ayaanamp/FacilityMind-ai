# ============================================================
# ANTIGRAVITY WORKSPACE ENVIRONMENT CONFIGURATION
# ============================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (SQLite default, PostgreSQL ready)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# LLM / AI Provider Configuration (Keys must never be committed)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# Vector / RAG Storage
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./data/chroma

# Frontend Client Configuration (Vite env prefix)
VITE_API_BASE_URL=http://localhost:8000/api/v1
